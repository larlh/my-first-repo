# syntax=docker/dockerfile:1
# One image for the API and the worker (same workspace, different command).
# Internal packages are consumed as TypeScript source, so the image runs them with tsx.
FROM node:22-bookworm-slim AS base
ENV PNPM_HOME=/pnpm PATH=/pnpm:$PATH NODE_ENV=production
RUN apt-get update \
 && apt-get install -y --no-install-recommends ffmpeg ca-certificates fontconfig \
 && rm -rf /var/lib/apt/lists/* \
 && corepack enable && corepack prepare pnpm@10.28.0 --activate
WORKDIR /app

FROM base AS deps
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json .npmrc ./
COPY packages/shared/package.json packages/shared/
COPY packages/db/package.json packages/db/
COPY packages/jobs/package.json packages/jobs/
COPY packages/renderer/package.json packages/renderer/
COPY packages/providers/package.json packages/providers/
COPY packages/templates/package.json packages/templates/
COPY packages/stock-assets/package.json packages/stock-assets/
COPY apps/api/package.json apps/api/
COPY apps/worker/package.json apps/worker/
COPY apps/web/package.json apps/web/
# tsx is a root devDependency and is needed at runtime: install everything.
RUN --mount=type=cache,id=pnpm,target=/pnpm/store pnpm install --frozen-lockfile --prod=false

FROM deps AS runtime
COPY tsconfig.base.json ./
COPY packages ./packages
COPY apps/api ./apps/api
COPY apps/worker ./apps/worker
RUN mkdir -p /data/storage && chown -R node:node /data /app
USER node
ENV STORAGE_LOCAL_DIR=/data/storage
EXPOSE 4000
# Overridden per service in docker-compose.yml.
CMD ["pnpm", "--filter", "@parlante/api", "start"]
