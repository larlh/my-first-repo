# Parlante web (apps/web) — environment variables. Copy to `apps/web/.env.local` if you need to
# change a default. Every variable is optional: with no file the app talks to the API through
# the Vite dev proxy at http://localhost:4000.

# Where the Vite dev/preview server forwards /api, /v1, /health, /docs and /openapi.json.
# Read by vite.config.ts (Node side), not shipped to the browser.
VITE_API_PROXY_TARGET=http://localhost:4000

# Base URL the BROWSER uses for API calls. Leave empty to use the same origin (dev proxy, or a
# reverse proxy in production). Set it (e.g. https://api.example.com) only when the web app and
# the API live on different origins; that origin must be listed in the API's WEB_ORIGIN.
VITE_API_URL=
