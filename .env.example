# Parlante — environment variables. Copy to `.env` (never commit it).
# Every variable has a working default for local development: with NO .env file the product
# runs fully offline (local providers). Validation lives in:
#   packages/shared/src/node/env.ts   (shared)      packages/providers/src/env.ts (providers)
#   apps/api/src/config.ts            (API)         apps/worker/src/config.ts     (worker)

# ---------------------------------------------------------------- general
NODE_ENV=development                  # development | test | production
LOG_LEVEL=info                        # fatal | error | warn | info | debug | trace | silent

# ---------------------------------------------------------------- infrastructure
DATABASE_URL=postgres://parlante:parlante@localhost:5432/parlante
# Maintenance connection used by tests to create one throw-away database per test run
# (the role needs CREATEDB; `pnpm services` grants it).
DATABASE_TEST_URL=postgres://parlante:parlante@localhost:5432/parlante_test
REDIS_URL=redis://localhost:6379
QUEUE_PREFIX=parlante                 # BullMQ key prefix (isolates environments)

# ---------------------------------------------------------------- security
# Signs file URLs and encrypts stored webhook secrets. REQUIRED in production (>= 32 chars).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
APP_SECRET=
PUBLIC_API_URL=http://localhost:4000  # public base URL of the API (file links, webhooks)
PUBLIC_WEB_URL=http://localhost:5173  # public base URL of the web app (share / invite links)

# ---------------------------------------------------------------- API (apps/api)
API_HOST=0.0.0.0
API_PORT=4000
WEB_ORIGIN=http://localhost:5173      # comma-separated origins allowed by CORS / CSRF check
SESSION_COOKIE_NAME=parlante_session
SESSION_TTL_DAYS=30
COOKIE_SECURE=auto                    # auto (secure in production) | true | false
TRUST_PROXY=false                     # true behind a reverse proxy (X-Forwarded-*)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=600                    # requests per minute per IP (global)
MAX_UPLOAD_MB=1024                    # hard cap for uploads (plans may be lower)
UPLOAD_TMP_DIR=                       # default: OS temp dir
ALLOW_PRIVATE_URLS=false              # allow webhooks / script URLs to private IPs (dev only)
OPENAPI_ENABLED=true                  # serve /docs and /openapi.json

# ---------------------------------------------------------------- worker (apps/worker)
WORKER_TMP_DIR=                       # default: OS temp dir
WORKER_QUEUES=                        # comma-separated queue keys to process (default: all)
WORKER_CONCURRENCY_RENDER=            # default 1
WORKER_CONCURRENCY_TRANSLATION=       # default 1
WORKER_CONCURRENCY_BATCH=             # default 2
WORKER_CONCURRENCY_PHOTOAVATAR=       # default 2
WORKER_CONCURRENCY_VOICECLONE=        # default 2
WORKER_CONCURRENCY_WEBHOOKDELIVERY=   # default 5
WORKER_CONCURRENCY_SYSTEM=            # default 2
WORKER_KEEP_TMP=false                 # keep per-job temp dirs (debugging)
FFMPEG_PATH=                          # default: ffmpeg on PATH
FFPROBE_PATH=                         # default: ffprobe on PATH

# ---------------------------------------------------------------- storage
STORAGE_PROVIDER=local                # local | s3
STORAGE_LOCAL_DIR=./data/storage      # relative paths resolve from the repo root
S3_ENDPOINT=                          # e.g. http://localhost:9000 (MinIO); empty for AWS
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# ---------------------------------------------------------------- AI providers
# `auto` (default) = use the external adapter when its key is set, otherwise the local one.
# The UI and API always say which provider produced a result ("modo básico" for local ones).

TTS_PROVIDER=auto                     # auto | espeak | elevenlabs | openai (default voice provider)
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2
OPENAI_API_KEY=
OPENAI_TTS_MODEL=gpt-4o-mini-tts

STT_PROVIDER=auto                     # auto | manual (user supplies transcript) | openai
OPENAI_STT_MODEL=whisper-1

LLM_PROVIDER=auto                     # auto | local (heuristic, "modo básico") | anthropic
TRANSLATION_PROVIDER=auto             # auto | local | anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

VOICE_CLONE_PROVIDER=auto             # auto | local (voice profile) | elevenlabs

MODERATION_PROVIDER=local             # local (blocklist)
MODERATION_EXTRA_BLOCKLIST=           # extra blocked terms, comma separated

# ---------------------------------------------------------------- photorealistic avatars
# Local neural engine (services/avatar-engine): open-source models, no paid service.
LIPSYNC_PROVIDER=local-neural         # local-neural | external
PORTRAIT_PROVIDER=local-neural
AVATAR_ENGINE_URL=http://127.0.0.1:8090
AVATAR_ENGINE_WORK_DIR=./data/avatar-engine   # shared with the engine (files exchanged by path)
AVATAR_ENGINE_MODELS_DIR=./data/models        # weight cache (downloaded with checksums, not versioned)
LIPSYNC_ENDPOINT_URL=                 # only with LIPSYNC_PROVIDER=external
LIPSYNC_API_KEY=

# ---------------------------------------------------------------- web (apps/web)
VITE_API_PROXY_TARGET=http://localhost:4000   # dev server proxies /api to this URL
