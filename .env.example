# Parlante — environment variables.
#
# You do not need this file to run Parlante locally: every variable has a working default and,
# with NO `.env`, the product runs fully offline with the local providers. To change something,
# copy this file to `.env` in the repo root (never commit it) and edit the lines you need.
#
# Who reads `.env`: the API, the worker and the database scripts (packages/shared/src/node/env.ts),
# the web dev server (apps/web/vite.config.ts: only VITE_* and WEB_*), the avatar engine launcher
# (services/avatar-engine/run.sh: only AVATAR_ENGINE_*, FFMPEG_PATH and HF_HOME) and Docker
# Compose. Variables already set in the shell always win.
#
# Format: KEY=value. Text after " #" is a comment; quote a value that contains " #".
# `KEY=` with nothing after it means "not set" (the default applies).
#
# Docker Compose: do NOT copy this whole file. The compose stack serves everything on
# http://localhost:8080 and sets its own URLs; a `.env` for it needs APP_SECRET (and
# AVATAR_ENGINE_TOKEN for the neural profile, plus provider keys if you have them). The
# PUBLIC_*_URL / WEB_ORIGIN values below are the ones of `pnpm dev` and would break it.
#
# Validation lives in:
#   packages/shared/src/node/env.ts   (shared)      packages/providers/src/env.ts (providers)
#   apps/api/src/config.ts            (API)         apps/worker/src/config.ts     (worker)
#   services/avatar-engine/parlante_engine/core/config.py  (engine)

# ---------------------------------------------------------------- general
NODE_ENV=development                  # development | test | production
LOG_LEVEL=info                        # fatal | error | warn | info | debug | trace | silent

# ---------------------------------------------------------------- infrastructure
DATABASE_URL=postgres://parlante:parlante@localhost:5432/parlante
# Maintenance connection used by the tests to create one throw-away database per test run
# (the role needs CREATEDB; `pnpm services` grants it).
DATABASE_TEST_URL=postgres://parlante:parlante@localhost:5432/parlante_test
REDIS_URL=redis://localhost:6379
QUEUE_PREFIX=parlante                 # BullMQ key prefix (isolates environments)

# ---------------------------------------------------------------- security
# Signs file URLs and encrypts stored webhook secrets. In development an insecure built-in
# value is used when this is empty. REQUIRED with NODE_ENV=production: at least 32 characters,
# random (the development default and low-variety values are refused). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it invalidates every file link already handed out and the stored webhook secrets.
APP_SECRET=
PUBLIC_API_URL=http://localhost:4000  # public base URL of the API (file links, webhook payloads)
PUBLIC_WEB_URL=http://localhost:5173  # public base URL of the web app (share / invite links)

# ---------------------------------------------------------------- API (apps/api)
API_HOST=0.0.0.0
API_PORT=4000
# Comma-separated origins the API accepts cookie requests from (CORS + Origin check on every
# mutation, login and sign-up). Must be exactly what the browser shows: opening the app on
# http://127.0.0.1:5173 with only http://localhost:5173 here is answered 403.
WEB_ORIGIN=http://localhost:5173
SESSION_COOKIE_NAME=parlante_session
SESSION_TTL_DAYS=30
COOKIE_SECURE=auto                    # auto (secure in production) | true | false
TRUST_PROXY=false                     # true behind a reverse proxy (X-Forwarded-*)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=600                    # requests per minute per IP (global; kept in process memory)
DICTATION_RATE_LIMIT_PER_MIN=60       # dictation: phrases per minute and user (needs RATE_LIMIT_ENABLED)
DICTATION_MAX_PENDING=4               # dictation: phrases running or waiting for the model at once (all users)
MAX_UPLOAD_MB=1024                    # hard cap for uploads (plans may be lower)
UPLOAD_TMP_DIR=                       # default: OS temp dir
# DEVELOPMENT ONLY. Lifts the SSRF guard so webhooks / "URL → script" may reach private and
# loopback addresses (e.g. a webhook receiver on localhost; scripts/e2e.sh turns it on for its
# own throw-away stack). Off by default; API and worker refuse to start with it on when
# NODE_ENV=production.
ALLOW_PRIVATE_URLS=false
OPENAPI_ENABLED=true                  # serve /docs, /openapi.json, /v1/docs and /v1/openapi.json

# ---------------------------------------------------------------- worker (apps/worker)
WORKER_TMP_DIR=                       # default: OS temp dir
WORKER_QUEUES=                        # comma-separated queue keys to process (default: all)
WORKER_CONCURRENCY_RENDER=            # default 1
WORKER_CONCURRENCY_TRANSLATION=       # default 1
WORKER_CONCURRENCY_BATCH=             # default 2
WORKER_CONCURRENCY_PHOTOAVATAR=       # default 2
WORKER_CONCURRENCY_VOICECLONE=        # default 2
WORKER_CONCURRENCY_WEBHOOKDELIVERY=   # default 5
WORKER_CONCURRENCY_SYSTEM=            # default 2
WORKER_KEEP_TMP=false                 # keep per-job temp dirs (debugging)
FFMPEG_PATH=                          # default: ffmpeg on PATH (also read by the avatar engine)
FFPROBE_PATH=                         # default: ffprobe on PATH

# ---------------------------------------------------------------- storage
STORAGE_PROVIDER=local                # local | s3
STORAGE_LOCAL_DIR=./data/storage      # relative paths resolve from the repo root
S3_ENDPOINT=                          # e.g. http://localhost:9000 (MinIO); empty for AWS
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
S3_SESSION_TOKEN=                     # only with temporary (STS) credentials
S3_PUBLIC_ENDPOINT=                   # endpoint written into signed URLs when browsers use another host (default: S3_ENDPOINT)

# ---------------------------------------------------------------- AI providers
# `auto` (default) = use the external adapter when its key is set, otherwise the local one.
# The UI and API always say which provider produced a result ("modo básico" for local ones).

# Voice. Local: eSpeak NG (44 voices, 13 languages, robotic). Every provider that has a key adds
# its voices to the catalogue; TTS_PROVIDER only chooses the default one.
TTS_PROVIDER=auto                     # auto | espeak | elevenlabs | openai
ELEVENLABS_API_KEY=                   # enables ElevenLabs voices and real voice cloning
ELEVENLABS_MODEL=eleven_multilingual_v2
ELEVENLABS_BASE_URL=https://api.elevenlabs.io   # change only for a proxy
OPENAI_API_KEY=                       # enables OpenAI voices and Whisper transcription
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_BASE_URL=https://api.openai.com/v1      # TTS + Whisper; any server with the same audio endpoints works

# Speech-to-text of whole recordings (video translation). `auto`: OpenAI when OPENAI_API_KEY is
# set; else the local Whisper model when it is installed (`pnpm dictation:setup`, see below);
# else `manual`: the user supplies the transcript.
STT_PROVIDER=auto                     # auto | manual | openai | local-whisper
OPENAI_STT_MODEL=whisper-1

# Dictation by microphone (and local speech-to-text). The model runs on THIS machine, on the
# CPU, in a worker thread; it is never downloaded at run time: install it once with
#   pnpm dictation:setup            (139 MB for whisper-base; files verified by SHA-256)
# Without it everything keeps working and dictation reports itself as not available.
# Dictation always uses this local model, whatever STT_PROVIDER says: its audio never leaves
# the machine and is never stored.
# Models (measured on 4 CPU cores, docs/MODELS.md): whisper-base answers a phrase in about 1.5 s
# and needs about 1.8 GB of RAM; whisper-small is more accurate but takes about 5 s per phrase
# (slower than speech) and about 3.9 GB. Install the one you choose: pnpm dictation:setup --model <id>
DICTATION_MODEL=whisper-base          # whisper-base | whisper-small
DICTATION_MODEL_DIR=./data/models     # where `pnpm dictation:setup` puts the model (relative to the repo root)
DICTATION_THREADS=0                   # CPU threads of the model; 0 = every core, up to 4
DICTATION_IDLE_UNLOAD_SEC=900         # free the model's memory after this long without use (0 = never)

# Script writer, interactive avatar chat and translation. Local: deterministic heuristics and a
# glossary, labelled "modo básico" and free of credits. With a key they use Claude and cost
# credits (1 per script, 2 per interactive session).
LLM_PROVIDER=auto                     # auto | local | anthropic
TRANSLATION_PROVIDER=auto             # auto | local | anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_FALLBACKS=true              # re-run a request declined by the model's safety classifiers on Anthropic's recommended fallback

# Voice cloning. Local: a "voice profile" (pitch and speed estimated from the sample applied to
# a local voice — it does not imitate the timbre). Always requires recorded consent.
VOICE_CLONE_PROVIDER=auto             # auto | local | elevenlabs

MODERATION_PROVIDER=local             # local (blocklist)
MODERATION_EXTRA_BLOCKLIST=           # extra blocked terms, comma separated

# ---------------------------------------------------------------- photorealistic avatars
# Local neural engine (services/avatar-engine, started with `pnpm avatar-engine`): open-source
# models, no paid service. Without it the 2D avatars keep working and the app says so.
LIPSYNC_PROVIDER=local-neural         # local-neural | external
PORTRAIT_PROVIDER=local-neural
AVATAR_ENGINE_URL=http://127.0.0.1:8090       # where API and worker reach the engine; the engine takes its port from it
AVATAR_ENGINE_TOKEN=                  # shared secret; REQUIRED when the engine is not on loopback (docker compose)
AVATAR_ENGINE_WORK_DIR=./data/avatar-engine   # shared with the engine, SAME absolute path in both (files exchanged by path)
AVATAR_ENGINE_MODELS_DIR=./data/models        # weight cache (downloaded with checksums, not versioned); read by the engine only
AVATAR_ENGINE_POLL_MS=1000            # ms between polls of an engine job (progress / ETA granularity)
AVATAR_ENGINE_STALL_SEC=900           # cancel a running engine job that reports no progress for this long
AVATAR_PORTRAIT_SIZE=768              # side of generated portraits in px (384…768; 512 is ~2x faster)
LIPSYNC_ENDPOINT_URL=                 # only with LIPSYNC_PROVIDER=external
LIPSYNC_API_KEY=                      # sent as `Authorization: Bearer` (contract: packages/providers/src/lipsync/external.ts)
LIPSYNC_STATUS_URL=                   # optional health URL of the external service (GET, 2xx = available)
LIPSYNC_TIMEOUT_SEC=1800              # give up on (and cancel) an external lip-sync job after this long

# Engine-only tuning (read by the Python service, not by Node). Defaults shown; uncomment to
# change. Full table with measurements: services/avatar-engine/README.md § Configuration.
# AVATAR_ENGINE_HOST=127.0.0.1               # bind address; a non-loopback value REQUIRES AVATAR_ENGINE_TOKEN
# AVATAR_ENGINE_PORT=8090                    # overrides the port taken from AVATAR_ENGINE_URL
# AVATAR_ENGINE_THREADS=4                    # inference threads (default: CPU count, at most 8)
# AVATAR_ENGINE_BACKEND=auto                 # auto | openvino | onnxruntime
# AVATAR_ENGINE_DEVICE=auto                  # auto | cpu | gpu (GPU path implemented, not verified)
# AVATAR_ENGINE_PRECISION=auto               # auto (bf16 where the CPU supports it) | f32 | bf16
# AVATAR_ENGINE_SHARPEN=0.6                  # unsharp mask on generated face crops (0 = off)
# AVATAR_ENGINE_PORTRAIT_MAX_SIDE=768        # side of prepared portraits (256…1024)
# AVATAR_ENGINE_PORTRAIT_STEPS=20            # sampler steps of portrait generation (8…40; time is linear in it)
# AVATAR_ENGINE_PORTRAIT_GUIDANCE=5.5        # classifier-free guidance of portrait generation (1.5…12)
# AVATAR_ENGINE_PORTRAIT_ATTEMPTS=4          # attempts while the automatic quality control fails (1…6)
# AVATAR_ENGINE_MAX_IMAGE_MB=25              # input limits
# AVATAR_ENGINE_MAX_AUDIO_MB=200
# AVATAR_ENGINE_MAX_CLIP_SECONDS=600
# AVATAR_ENGINE_JOB_TTL_SECONDS=3600         # how long a finished engine job stays queryable
# AVATAR_ENGINE_STARTUP_BENCHMARK=1          # 0 = do not measure the generator at first start
# AVATAR_ENGINE_AUDIO_FEATURES_BACKEND=onnxruntime   # openvino = faster audio driver, +0.7 GB RAM
# AVATAR_ENGINE_MODEL_SEARCH_DIRS=           # extra directories with already downloaded weights (path-separator list)
# HF_HOME=                                   # a Hugging Face cache whose verified files are reused in place
# Launcher only (services/avatar-engine/run.sh):
# AVATAR_ENGINE_PYTHON=python3               # interpreter used to create the virtualenv (3.11–3.13)
# AVATAR_ENGINE_SKIP_DOWNLOAD=1              # never download weights at start
# AVATAR_ENGINE_DOWNLOAD_ARGS=--minimal      # --minimal (0.56 GB, no portrait generation) | --with-audio (+1.65 GB) | --all

# ---------------------------------------------------------------- web (apps/web)
WEB_PORT=5173                         # port of the Vite dev / preview server
VITE_API_PROXY_TARGET=http://localhost:4000   # the dev server proxies /api, /v1, /docs… to this URL (follow API_PORT)
# Base URL the BROWSER uses for API calls, baked in at build time. Leave empty for same origin
# (dev proxy, or a reverse proxy in production). Set it only when web and API live on different
# origins; that origin must then be listed in WEB_ORIGIN.
VITE_API_URL=

# ---------------------------------------------------------------- scripts and tests (shell only)
# Not read from this file: export them in the shell when you need them.
#   scripts/dev-services.sh (`pnpm services`):  PGPORT (5432)  REDIS_PORT (6379)  PGDATA
#                                               PARLANTE_DB_USER (parlante)  PARLANTE_DB_PASSWORD (parlante)
#   scripts/e2e.sh and e2e/*.mjs:               E2E_* and PLAYWRIGHT_MODULE — see e2e/README.md and the script headers
#   renderer tests:                             UPDATE_GOLDEN=1 (rewrite golden frames)  PARLANTE_KEEP_OUTPUT=1
#   apps/api/src/security/scripts:              LIVE_API_URL (API to attack with the live isolation matrix)
